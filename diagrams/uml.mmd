classDiagram
    class Owner {
        +String name
        +int available_time_per_day
        +List~Pet~ pets
        +add_pet(pet)
        +get_today_schedule()
    }
    class Pet {
        +String name
        +String species
        +int age
        +List~Task~ tasks
        +add_task(task)
        +get_upcoming_tasks()
    }
    class Task {
        +String task_type
        +String due_time
        +int priority
        +bool is_recurring
        +bool is_complete
        +mark_complete()
        +is_overdue()
    }
    class Scheduler {
        +List~Task~ all_tasks
        +int owner_time_available
        +prioritize_tasks()
        +detect_conflicts()
        +generate_daily_plan()
    }
    Owner "1" --> "many" Pet : owns
    Pet "1" --> "many" Task : has
    Scheduler --> Task : organizes