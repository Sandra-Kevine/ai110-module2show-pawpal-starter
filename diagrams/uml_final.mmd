classDiagram
    class Task {
        +String task_type
        +String due_time
        +int priority
        +bool is_recurring
        +bool is_complete
        +String frequency
        +mark_complete()
        +is_overdue()
        +create_next_occurrence()
    }

    class Pet {
        +String name
        +String species
        +int age
        +List~Task~ tasks
        +add_task(task)
        +get_upcoming_tasks()
    }

    class Owner {
        +String name
        +int available_time_per_day
        +List~Pet~ pets
        +add_pet(pet)
        +get_all_tasks()
        +get_today_schedule()
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks()
        +prioritize_tasks()
        +detect_conflicts()
        +generate_daily_plan()
        +sort_by_time()
        +filter_tasks(pet_name, is_complete)
        +complete_task(task)
    }

    Owner "1" o-- "0..*" Pet : manages
    Pet "1" o-- "0..*" Task : has
    Scheduler --> Owner : retrieves tasks from
    Scheduler ..> Task : sorts and schedules
